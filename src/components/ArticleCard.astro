---
import TagPill from './TagPill.astro';
import SeriesBadge from './SeriesBadge.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  series?: {
    name: string;
    slug: string;
    part: number;
    totalParts: number;
  };
}

const { slug, title, description, pubDate, tags, series } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group border-b border-[#D8D0C0] py-10 first:pt-0 last:border-none">
  <div class="flex flex-col gap-3">
    {series && (
      <div>
        <SeriesBadge {...series} compact />
      </div>
    )}

    <div class="flex items-center gap-3">
      <time
        datetime={pubDate.toISOString()}
        class="font-sans text-sm text-[#A09890] tabular-nums"
      >
        {formattedDate}
      </time>
    </div>

    <h2 class="font-display text-2xl md:text-3xl font-bold text-[#1A1714] leading-tight group-hover:text-[#8B3A2A] transition-colors duration-200">
      <a href={`/articulos/${slug}`} class="hover:underline decoration-1 underline-offset-4">
        {title}
      </a>
    </h2>

    <p class="font-serif text-[#4A4540] leading-relaxed text-base line-clamp-3">
      {description}
    </p>

    <div class="flex items-center justify-between gap-4 mt-1">
      <div class="flex flex-wrap gap-2">
        {tags.map(tag => <TagPill tag={tag} />)}
      </div>
      <a
        href={`/articulos/${slug}`}
        class="font-sans text-sm text-[#8B3A2A] hover:text-[#6B2B1D] flex items-center gap-1.5 shrink-0 transition-colors duration-150"
        aria-label={`Leer: ${title}`}
      >
        Leer
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</article>
