---
const pathname = Astro.url.pathname;
---

<header class="border-b border-[#D8D0C0]">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="text-center mb-6">
      <a href="/" class="group inline-block">
        <h1
          class="font-display text-4xl md:text-5xl font-bold tracking-tight text-[#1A1714] leading-tight group-hover:text-[#8B3A2A] transition-colors duration-300"
        >
          Lo que había en la olla
        </h1>
      </a>
      <p class="font-serif italic text-[#7A736A] mt-2 text-base">
        Historia de la cocina contada desde los que cocinaban
      </p>
    </div>
  </div>
</header>
