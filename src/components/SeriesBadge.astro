---
interface Props {
  name: string;
  part: number;
  totalParts: number;
  slug: string;
  compact?: boolean;
}

const { name, part, totalParts, slug, compact = false } = Astro.props;
---

{compact ? (
  <div class="inline-flex items-center gap-2 font-sans text-xs text-[#8B3A2A]">
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M1 2h10M1 6h7M1 10h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <span>Serie · Parte {part} de {totalParts}</span>
  </div>
) : (
  <div class="border border-[#D8D0C0] bg-[#F0EAD8] px-5 py-4 rounded-sm">
    <div class="flex items-center gap-2 mb-1">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 2h12M1 6h9M1 10h11" stroke="#8B3A2A" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="font-sans text-xs uppercase tracking-widest text-[#8B3A2A]">Serie</span>
    </div>
    <p class="font-display font-semibold text-[#1A1714] text-base leading-snug">
      {name}
    </p>
    <p class="font-sans text-sm text-[#7A736A] mt-1">
      Parte {part} de {totalParts}
    </p>
  </div>
)}
