---
interface Props {
  tag: string;
  linked?: boolean;
}

const { tag, linked = true } = Astro.props;
const slug = tag.toLowerCase().replace(/\s+/g, '-');
---

{linked ? (
  <a
    href={`/etiquetas/${slug}`}
    class="inline-block font-sans text-xs tracking-wide uppercase px-2.5 py-1 bg-[#E8E0D0] text-[#7A736A] hover:bg-[#D8D0C0] hover:text-[#1A1714] transition-colors duration-150 rounded-sm"
  >
    {tag}
  </a>
) : (
  <span class="inline-block font-sans text-xs tracking-wide uppercase px-2.5 py-1 bg-[#E8E0D0] text-[#7A736A] rounded-sm">
    {tag}
  </span>
)}
