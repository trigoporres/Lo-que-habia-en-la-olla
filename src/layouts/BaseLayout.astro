---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: {
    pubDate: Date;
    author: string;
    tags: string[];
  };
}

const { title, description, ogImage, article } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      article={article}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F5EFE0]">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
